# Copy this file to .env.local and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client code — and being
# client code, all three of these end up readable in the shipped bundle.

# Supabase project URL and anon (public) key, used to store bookings/waitlist
# in the `ww_bookings` table. The anon key is safe to ship as long as Row
# Level Security policies on that table are correctly locked down.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Brevo (Sendinblue) transactional email API key, used to send booking and
# waitlist notification emails.
#
# WARNING: this key is NOT safe to ship to the browser the way it's used
# today (see src/lib/email.js) — anyone can extract it from the built JS and
# send email as this account. Treat this as a known issue to fix (proxy the
# send through a small serverless function) before relying on this in
# production.
VITE_BREVO_API_KEY=your-brevo-api-key
