# Copy this file to .env.local and fill in real values for local dev.
# VITE_-prefixed variables are inlined into the client bundle at build time
# — anyone who opens dev tools on the deployed site can read them. That's
# expected/safe for the Supabase anon key (RLS is the real protection), but
# is why the Brevo key below is deliberately NOT one of these anymore.

# Supabase project URL and anon (public) key. Used by BOTH apps in this
# repo: Room Booking (the `ww_bookings` table) and the Staff Portal (the
# `staff_*` tables — see supabase/staff-portal-schema.sql, which you need
# to run once before /staff will work). Can be the same Supabase project
# for both, or point each app's deployment at a different one. The anon
# key is safe to ship as long as Row Level Security policies on every
# table are correctly locked down.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Brevo (Sendinblue) transactional email API key — NOT prefixed with VITE_,
# on purpose: it's read server-side only, by netlify/functions/send-email.js,
# and must never be inlined into the client bundle. Set it in your hosting
# provider's environment variables (Netlify: Site configuration →
# Environment variables), not in a client .env file that gets built into the
# bundle. For local testing of the function itself, `netlify dev` (via
# `npx netlify-cli dev`) reads it from .env.local same as the VITE_ vars —
# plain `npm run dev` (vite only) won't run the function at all, so email
# sends will just log a fetch error locally, which is expected.
BREVO_API_KEY=your-brevo-api-key
